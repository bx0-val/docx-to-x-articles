{
  "name": "docx-to-x-articles",
  "description": "Drag a Word (.docx) file onto an X Articles draft to import its title, formatting and images.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixture.mjs",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "wxt prepare",
    "test:e2e": "node scripts/harness-e2e.mjs"
  },
  "devDependencies": {
    "@types/draft-js": "^0.11.20",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "docx": "^9.8.1",
    "draft-js": "^0.11.7",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0"
  }
}
